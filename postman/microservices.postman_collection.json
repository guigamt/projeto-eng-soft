  "item": [
    {
      "name": "auth-svc",
      "item": [
        {
          "name": "Registrar usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"colab@example.com\",\n  \"password\": \"123456\",\n  \"full_name\": \"Colaborador Teste\",\n  \"role\": \"COLLABORATOR\"\n}"
            },
            "url": {
              "raw": "{{auth_base_url}}/auth/register",
              "host": [
                "{{auth_base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Gerar token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "colab@example.com"
                },
                {
                  "key": "password",
                  "value": "123456"
                }
              ]
            },
            "url": {
              "raw": "{{auth_base_url}}/auth/token",
              "host": [
                "{{auth_base_url}}"
              ],
              "path": [
                "auth",
                "token"
              ]
            }
          }
        },
        {
          "name": "Perfil autenticado",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{auth_base_url}}/auth/me",
              "host": [
                "{{auth_base_url}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          }
        }
      ]
    },
